<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/cartProductImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/baseline_cookie_24"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/cartProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Назва товару"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/cartProductDecrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/minus"
                android:contentDescription="Зменшити кількість"/>

            <TextView
                android:id="@+id/cartProductQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="16sp"
                android:paddingHorizontal="12dp"/>

            <ImageView
                android:id="@+id/cartProductIncrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/plus"
                android:contentDescription="Збільшити кількість"/>
        </LinearLayout>

        <TextView
            android:id="@+id/cartProductTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Всього: 100 грн"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/cartProductDelete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="Видалити товар"
        android:src="@drawable/baseline_cancel_24"/>
</LinearLayout>
